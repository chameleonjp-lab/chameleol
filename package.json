{
  "name": "chameleol",
  "version": "0.1.0",
  "private": true,
  "description": "カメレオる — 建物の色に体色を合わせて逃げるスマートフォン向けブラウザゲーム",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node scripts/sync-shared.mjs --check && node --test tests/**/*.test.mjs",
    "test:rules": "node --test tests/rules/*.test.mjs",
    "test:sql": "node scripts/run-sql-tests.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.e2e.mjs",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "report:course": "node scripts/course-report.mjs",
    "report:color": "node scripts/color-table.mjs",
    "sync": "node scripts/sync-shared.mjs",
    "check:engines": "node scripts/cross-engine-check.mjs",
    "fixtures:replay": "node scripts/make-replay-fixtures.mjs",
    "smoke:edge": "node scripts/deno-edge-smoke.mjs"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.7",
    "pg": "8.23.1",
    "quickjs-emscripten": "0.32.0"
  }
}
